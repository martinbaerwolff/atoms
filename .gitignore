# =====================================================================
# Atoms — gitignore
# =====================================================================

# --- Secrets / local env ---------------------------------------------
.env
.env.*
!.env.example
.envrc
*.local

# --- Python / uv / virtualenv ----------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# Explicitly keep the SvelteKit lib directory
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/
ENV/
.python-version
# uv lock — we DO commit it (reproducible installs); keep this comment for clarity.

# --- Test / lint cache -----------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# --- Node / Frontend -------------------------------------------------
node_modules/
.svelte-kit/
.vite/
.turbo/
.next/
.parcel-cache/
.svelte-kit-cache/
build/
.output/
.vercel/

# --- Test results / Playwright ---------------------------------------
test-results/
playwright-report/
playwright/.cache/

# --- Coverage / reports ----------------------------------------------
coverage/
*.lcov

# --- Logs ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS files --------------------------------------------------------
.DS_Store
Thumbs.db

# --- Editor ----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json

# --- Docker / data ---------------------------------------------------
data/
!data/.gitkeep

# --- Claude local overrides ------------------------------------------
.claude/settings.local.json
.claude/.session/
