# Copy to .env (gitignored) for local development.

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=atoms
POSTGRES_PASSWORD=atoms
POSTGRES_DB=atoms
POSTGRES_PORT=5432

# --- Backend ----------------------------------------------------------
# Inside docker compose, use service hostname `db`.
# When running pytest on host against compose db, use localhost.
DATABASE_URL=postgresql+asyncpg://atoms:atoms@db:5432/atoms
BACKEND_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=dev

# --- Frontend ---------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
